{
	"schemaVersion": 1,
	"id": "modfactory",
	"version": "${version}",
	"name": "ModFactory Development Mod",
	"description": "Runnable Fabric development client for ModFactory.",
	"authors": [
		"ModFactory contributors"
	],
	"contact": {
		"homepage": "https://github.com/buyicoder/modfactory",
		"sources": "https://github.com/buyicoder/modfactory"
	},
	"license": "CC0-1.0",
	"icon": "assets/modfactory/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.modfactory.ModFactory"
		],
		"client": [
			"dev.modfactory.client.ModFactoryClient"
		]
	},
	"mixins": [
		"modfactory.mixins.json",
		{
			"config": "modfactory.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
